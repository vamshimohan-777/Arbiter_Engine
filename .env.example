# Arbiter Engine — Environment Variables
# Copy this file to .env and fill in your API keys.

# ── LLM Provider API Keys ─────────────────────────────────────────────────
# Groq (required — primary LLM for reasoning and checking)
GROQ_API_KEY=gsk_your-groq-key-here

# Cerebras (optional — available for an explicitly configured deployment)
CEREBRAS_API_KEY=csk-your-cerebras-key-here

# OpenRouter (recommended — fallback when primary providers are unavailable)
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# ── Provider Base URLs (defaults shown, change only if using proxies) ─────
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Central LLM Gateway ───────────────────────────────────────────────────
# Provider names: groq, cerebras, openrouter. The fallback is tried only
# after bounded retries of the primary provider. Never commit real keys.
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=openrouter
# Keep checks on the verified primary provider by default. Change either only
# after testing that provider's model and structured JSON response contract.
PRECEDENT_PROVIDER=groq
SIMULATION_PROVIDER=groq
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_CIRCUIT_BREAKER_FAILURES=3
LLM_PROVIDER_COOLDOWN_SECONDS=30
LLM_RATE_LIMIT_COOLDOWN_SECONDS=60
FRONTEND_ORIGIN=http://localhost:3000

# ── Agent Model Assignments ───────────────────────────────────────────────
# All built-in agents use this verified Groq model by default. It reserves
# completion tokens for reasoning, so do not lower the agent output caps.
# RESOLUTION_MODEL=openai/gpt-oss-120b
# CHECKER_MODEL=openai/gpt-oss-120b
# RETRIEVAL_MODEL=openai/gpt-oss-120b
# SENSITIVITY_MODEL=openai/gpt-oss-120b
# SCANNER_MODEL=openai/gpt-oss-120b
# PRECEDENT_MODEL=openai/gpt-oss-120b
# SIMULATION_MODEL=openai/gpt-oss-120b
# FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct

# ── Storage Paths (relative to arbiter/backend/) ─────────────────────────
# SQLITE_PATH=./arbiter.db
# CHROMA_PATH=./chroma_db
# POLICIES_DIR=./data/policies
# PRECEDENTS_DIR=./data/precedents

# ── Application Behavior ──────────────────────────────────────────────────
# LOG_LEVEL=INFO
# MAX_CHECKER_ROUNDS=2
# CHROMA_COLLECTION_NAME=arbiter_policies
