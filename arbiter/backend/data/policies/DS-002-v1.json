      "clause_type": "RULE",
      "text": "Dataset Z may be shared with any Tier 1 or Tier 2 Approved Vendor.",
      "metadata": {
        "applies_to_dataset": "Dataset Z",
        "permitted_vendor_tiers": ["Tier 1", "Tier 2"]
      }
    },
    {
      "section_id": "DS-002-v1-S2",
      "clause_type": "RULE",
      "text": "Dataset Z does not require DPA for sharing with Tier 1 vendors.",
      "metadata": {
        "applies_to_dataset": "Dataset Z",
        "applies_to_vendor_tier": "Tier 1",
        "dpa_required": false
      }
    },
    {
      "section_id": "DS-002-v1-S3",
      "clause_type": "DEFINITION",
      "text": "Tier 1 Vendor means vendors with Platinum or Gold partner status. Tier 2 Vendor means vendors with Silver partner status.",
